import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA, FactorAnalysis, FastICA
from sklearn.mixture import GaussianMixture
from sklearn.metrics import silhouette_score
data = {
    "Alcohol": [14.23,13.20,13.16,14.37,13.24,14.20,14.39,14.06,14.83,13.86],
    "MalicAcid": [1.71,1.78,2.36,1.95,2.59,1.76,1.87,2.15,1.64,1.35],
    "Ash": [2.43,2.14,2.67,2.50,2.87,2.45,2.45,2.61,2.17,2.27],
    "Alkalinity": [15.6,11.2,18.6,16.8,21.0,15.2,14.6,17.6,14.0,16.0],
    "Magnesium": [127,100,101,113,118,112,96,121,97,98],
    "Phenols": [2.80,2.65,2.80,3.85,2.80,3.27,2.50,2.60,2.80,2.98]
}
df = pd.DataFrame(data)
print("Original Dataset:")
print(df)
scaler = StandardScaler()
X_scaled = scaler.fit_transform(df)
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_scaled)
print("\nPCA Explained Variance:")
print(pca.explained_variance_ratio_)
fa = FactorAnalysis(
    n_components=2,
    random_state=42
)
X_fa = fa.fit_transform(X_scaled)
ica = FastICA(
    n_components=2,
    random_state=42,
    max_iter=1000
)
X_ica = ica.fit_transform(X_scaled)
gmm_pca = GaussianMixture(
    n_components=2,
    random_state=42,
    n_init=10
)
gmm_fa = GaussianMixture(
    n_components=2,
    random_state=42,
    n_init=10
)
gmm_ica = GaussianMixture(
    n_components=2,
    random_state=42,
    n_init=10
)
cluster_pca = gmm_pca.fit_predict(X_pca)
cluster_fa = gmm_fa.fit_predict(X_fa)
cluster_ica = gmm_ica.fit_predict(X_ica)
df["PCA_Cluster"] = cluster_pca
df["FA_Cluster"] = cluster_fa
df["ICA_Cluster"] = cluster_ica
print("\nClustering Results:")
print(df)
pca_score = silhouette_score(X_pca, cluster_pca)
fa_score = silhouette_score(X_fa, cluster_fa)
ica_score = silhouette_score(X_ica, cluster_ica)
print("\nSilhouette Scores:")
print("PCA + GMM =", round(pca_score, 3))
print("FA + GMM  =", round(fa_score, 3))
print("ICA + GMM =", round(ica_score, 3))
plt.scatter(
    X_pca[:, 0],
    X_pca[:, 1],
    c=cluster_pca,
    s=100
)
plt.xlabel("PCA Component 1")
plt.ylabel("PCA Component 2")
plt.title("PCA + Gaussian Mixture Model")
plt.show()
plt.scatter(
    X_fa[:, 0],
    X_fa[:, 1],
    c=cluster_fa,
    s=100
)
plt.xlabel("Factor 1")
plt.ylabel("Factor 2")
plt.title("Factor Analysis + Gaussian Mixture Model")
plt.show()
plt.scatter(
    X_ica[:, 0],
    X_ica[:, 1],
    c=cluster_ica,
    s=100
)
plt.xlabel("Independent Component 1")
plt.ylabel("Independent Component 2")
plt.title("ICA + Gaussian Mixture Model")
plt.show()
